{
  "name": "carryfeed-agent-tools",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "carryfeed-agent-tools",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@carryfeed/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@carryfeed/sdk": {
      "resolved": "packages/sdk",
      "link": true
    },
    "packages/cli": {
      "name": "@carryfeed/cli",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@carryfeed/sdk": "0.1.0"
      },
      "bin": {
        "carryfeed": "src/index.js"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/sdk": {
      "name": "@carryfeed/sdk",
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=18"
      }
    }
  }
}
